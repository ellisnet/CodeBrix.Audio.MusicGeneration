<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CodeBrix.Audio.MusicGeneration</AssemblyName>
    <RootNamespace>CodeBrix.Audio.MusicGeneration</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    Package / assembly version: date-stamped and auto-incrementing.

    Format:  1.<x>.<y>.<z>   (every field is derived from UTC "now")

      1  (major)     Always 1 for this library.
      x  (minor)     Whole years since $(_VersionBaseYear).
                     With base 2026: 2026=0, 2027=1, 2028=2, ...
      y  (build)     Day of year, 1-based inclusive, UTC.
                     Jan 1 = 1, Feb 1 = 32, Dec 31 = 365 (366 in a leap year).
      z  (revision)  Minute of day, UTC, range 0 to 1439.
                     00:00 = 0, 23:59 = 1439.

    The version is always strictly increasing over time:
      * within a day, z grows;
      * at a day boundary, y increments and outranks z resetting to 0;
      * at a (UTC) year boundary, x increments and outranks y and z resetting.

    Notes / caveats:
      * All fields read from System.DateTime.UtcNow, so a local dev build and a
        UTC CI build agree on the value. Math.Floor on the minutes keeps z in
        0..1439 (plain rounding could land on 1440 late in the day).
      * Because the value depends on the clock, every build produces a NEW
        version. With GeneratePackageOnBuild=true that means a fresh .nupkg on
        each build, and two builds in the SAME UTC minute produce the SAME
        version (so do not publish two packages from within one minute).
      * This is date-stamp versioning, not SemVer: minor encodes the year and
        major is pinned to 1, so major/minor do not signal API compatibility.
      * To re-baseline the minor number, change _VersionBaseYear below.
  -->
  <PropertyGroup>
    <_VersionBaseYear>2026</_VersionBaseYear>
    <_VersionYears>$([MSBuild]::Subtract($([System.DateTime]::UtcNow.Year), $(_VersionBaseYear)))</_VersionYears>
    <_VersionDayOfYear>$([System.DateTime]::UtcNow.DayOfYear)</_VersionDayOfYear>
    <_VersionMinuteOfDay>$([System.Convert]::ToInt32($([System.Math]::Floor($([System.DateTime]::UtcNow.TimeOfDay.TotalMinutes)))))</_VersionMinuteOfDay>
    <BuildVersion>1.$(_VersionYears).$(_VersionDayOfYear).$(_VersionMinuteOfDay)</BuildVersion>
    <Version>$(BuildVersion)</Version>
    <AssemblyVersion>$(BuildVersion)</AssemblyVersion>
    <FileVersion>$(BuildVersion)</FileVersion>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>CodeBrix.Audio.MusicGeneration.MitLicenseForever</PackageId>
    <Product>CodeBrix.Audio.MusicGeneration</Product>
    <Title>CodeBrix.Audio.MusicGeneration</Title>
    <Authors>Jeremy Ellis</Authors>
    <Description>Model-generated music for .NET. The library generates music - from a piece it carries, or from a music model the application registers - voices it through a CodeBrix.Audio instrument library, and either plays it while it is still being generated or renders it to an audio file. No Python, and nothing to install.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ellisnet/CodeBrix.Audio.MusicGeneration</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ellisnet/CodeBrix.Audio.MusicGeneration</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>icon-codebrix-128.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright (c) 2026 Jeremy Ellis and contributors</Copyright>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <IsPackable>true</IsPackable>
    <PackageTags>audio;midi;music;music-generation;generative;abc-notation;CodeBrix</PackageTags>
  </PropertyGroup>

  <!--
    THE WHOLE DEPENDENCY SET, AND IT NEVER GROWS. Three package references, no more: read the
    "DEPENDENCIES" section of MAINTAINER-README.txt before touching this group.
  -->
  <ItemGroup>
    <PackageReference Include="CodeBrix.Audio.MitLicenseForever" Version="1.0.267.279" />
    <!--
      DELIBERATE, although no code in this library ever names a ModestSynth type: one package
      reference has to bring a consumer everything needed to make a sound, and ModestSynth is where
      the General MIDI instrument library lives. Do not remove it as "unused".
    -->
    <PackageReference Include="CodeBrix.Audio.ModestSynth.MitLicenseForever" Version="1.0.267.279" />
    <PackageReference Include="CodeBrix.Ollama.ModelRunner.MitLicenseForever" Version="1.0.266.110" />
  </ItemGroup>

  <!--
    THE EMBEDDED MUSIC. Four small pieces of model-generated music ship inside the assembly so that
    a consumer with no model, no download and no configuration still gets music. The logical names
    are spelled out rather than inferred, because the replay generators look them up by name.
  -->
  <ItemGroup>
    <EmbeddedResource Include="EmbeddedMusic\skytnt-fp32-dense-long-seed20260918-2000ev.mid" LogicalName="CodeBrix.Audio.MusicGeneration.EmbeddedMusic.skytnt-fp32-dense-long-seed20260918-2000ev.mid" />
    <EmbeddedResource Include="EmbeddedMusic\skytnt-fp32-ordinary.mid" LogicalName="CodeBrix.Audio.MusicGeneration.EmbeddedMusic.skytnt-fp32-ordinary.mid" />
    <EmbeddedResource Include="EmbeddedMusic\mupt-q8_0-duet-Am-waltz-seed29.abc" LogicalName="CodeBrix.Audio.MusicGeneration.EmbeddedMusic.mupt-q8_0-duet-Am-waltz-seed29.abc" />
    <EmbeddedResource Include="EmbeddedMusic\mupt-q8_0-air-Dmix-seed11.abc" LogicalName="CodeBrix.Audio.MusicGeneration.EmbeddedMusic.mupt-q8_0-air-Dmix-seed11.abc" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\icon-codebrix-128.png" Pack="true" PackagePath="" />
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
    <None Include="..\..\AGENT-README.txt" Pack="true" PackagePath="" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
